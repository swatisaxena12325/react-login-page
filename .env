# =============================================================================
# React Login Page  --  Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Generate a strong random secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=OYHJhskk99txVp9c413rxtBjUscgqiWFQ0J89Vvm1cE

# -----------------------------------------------------------------------------
# Email sender identity
# -----------------------------------------------------------------------------
SMTP_FROM_NAME=React Auth
SMTP_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# SMTP configuration
# -----------------------------------------------------------------------------
# Leave ALL four variables empty / unset to fall back to Ethereal (demo only).
# Set all four to use a real mail server.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # set to true only when SMTP_PORT=465
SMTP_USER=swatisaxena12325@gmail.com
SMTP_PASS=slsntpmcwuronpqq

# =============================================================================
# Provider-specific examples  (uncomment one block, remove the generic block)
# =============================================================================

# --- Gmail (App Password required -- 2FA must be enabled) --------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx       # 16-char App Password from myaccount.google.com

# --- Outlook / Microsoft 365 ------------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@outlook.com
# SMTP_PASS=your_password

# --- SendGrid ----------------------------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey                    # literal string "apikey"
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxx   # your SendGrid API key

# --- Mailgun SMTP ------------------------------------------------------------
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASS=your_mailgun_smtp_password

# --- Resend ------------------------------------------------------------------
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend                    # literal string "resend"
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx   # your Resend API key

# --- Amazon SES (us-east-1 example) -----------------------------------------
